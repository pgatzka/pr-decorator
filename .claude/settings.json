{
  "permissions": {
    "allow": [
      "Bash(gh --version)",
      "Bash(gh auth status:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue status:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh label list:*)",
      "Bash(gh search:*)",
      "Bash(gh repo view:*)"
    ],
    "ask": [
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh label create:*)",
      "Bash(gh label edit:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh api:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh label delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh auth token:*)"
    ]
  }
}
